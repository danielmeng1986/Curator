{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curator://album-analysis/vision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene", "people", "location_environment", "subjects", "objects", "actions", "confidence", "warnings"],
  "properties": {
    "scene": {"type": "string", "minLength": 1, "maxLength": 500},
    "people": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 100}, "maximum": {"type": "integer", "minimum": 0, "maximum": 100}}
    },
    "location_environment": {"type": "string", "minLength": 1, "maxLength": 500},
    "subjects": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "objects": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "actions": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
  }
}
