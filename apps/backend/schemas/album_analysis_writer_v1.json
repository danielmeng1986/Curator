{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curator://album-analysis/writer/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["album_summary", "description", "suggested_names"],
  "properties": {
    "album_summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "suggested_names": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "description": "Ordered English Album names using 2, 2, 3, 3, then natural 3-or-4-word slots.", "items": {"type": "string"}}
  }
}
