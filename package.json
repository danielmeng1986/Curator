{
  "name": "curator",
  "private": true,
  "scripts": {
    "test:web:contract": "node --test apps/web/tests/*_test.mjs",
    "test:web:e2e": "node tools/run_web_e2e.mjs",
    "test:web:e2e:all-browsers": "CURATOR_E2E_ALL_BROWSERS=1 node tools/run_web_e2e.mjs",
    "test:web:import": "node apps/web/tests/import_full_browser_acceptance.mjs",
    "test:web:repair-quarantine": "node apps/web/tests/repair_quarantine_full_browser_acceptance.mjs",
    "test:web:permission-disclosure": "node apps/web/tests/permission_disclosure_full_browser_acceptance.mjs",
    "test:ui-readiness": "node tools/run_ui_readiness.mjs",
    "playwright:install": "playwright install chromium",
    "playwright:install:all": "playwright install chromium webkit firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1"
  }
}
